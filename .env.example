# Crie em https://aistudio.google.com/apikey. Sem chave, usa dicas locais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12
HOST=127.0.0.1
PORT=8000
CACHE_TTL_SECONDS=900
CACHE_MAXSIZE=512
HTTP_TIMEOUT_SECONDS=10
# O banco padrão é weather_app.db na raiz do projeto.
# DATABASE_URL=sqlite+aiosqlite:///./weather_app.db
# Arrays JSON. Acrescente o domínio real ao publicar.
TRUSTED_HOSTS=["localhost","127.0.0.1","[::1]"]
CORS_ORIGINS=[]
# API gratuita para uso não comercial. Para plano comercial, configure as
# URLs de cliente indicadas no seu plano e a chave de assinatura.
OPEN_METEO_API_KEY=
FORECAST_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

